generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum VoucherType {
  PERCENT
  FIXED
}

enum VoucherScope {
  ALL
  CATEGORY
  PRODUCT
}

enum VoucherStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
  DEPLETED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
  VNPAY
  MOMO
  ZALOPAY
}

enum ConfirmationType {
  MANUAL
  WEBHOOK
  COD_COLLECTION
}

enum PaymentStatus {
  PENDING
  AWAITING_CONFIRM
  CONFIRMED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model User {
  id             String          @id @default(uuid())
  name           String
  email          String          @unique
  password       String?
  avatar         String?
  googleId       String?         @unique
  provider       AuthProvider    @default(LOCAL)
  role           Role            @default(CUSTOMER)
  emailVerified  Boolean         @default(false)
  bannedAt       DateTime?
  refreshTokens  RefreshToken[]
  reviews        Review[]
  reviewComments ReviewComment[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  orders        Order[]
  addresses     Address[]
  voucherUsages VoucherUsage[]
  returnRequests ReturnRequest[]

  cart Cart?

  confirmedPayments Payment[] @relation("PaymentConfirmedBy")
  refundedReturnRequests ReturnRequest[] @relation("ReturnRefundedBy")

  @@index([deletedAt])
  @@index([createdAt])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Category {
  id       String     @id @default(uuid())
  name     String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToCategory")
  products Product[]

  voucherCategories VoucherCategory[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([parentId])
  @@index([deletedAt])
  @@map("categories")
}

model Product {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  sku         String  @unique
  description String? @db.Text

  price          Decimal  @db.Decimal(12, 0)
  compareAtPrice Decimal? @db.Decimal(12, 0)

  length    Decimal?          @db.Decimal(6, 1)
  width     Decimal?          @db.Decimal(6, 1)
  height    Decimal?          @db.Decimal(6, 1)
  materials ProductMaterial[]

  status    ProductStatus @default(DRAFT)
  soldCount Int           @default(0)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  images   ProductImage[]
  variants ProductVariant[]
  reviews  Review[]

  voucherProducts VoucherProduct[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  orderItems OrderItem[]

  @@index([categoryId])
  @@index([status])
  @@index([deletedAt])
  @@map("products")
}

model ProductMaterial {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  value     String
  sortOrder Int     @default(0)

  @@index([productId])
  @@map("product_materials")
}

model ProductVariant {
  id            String   @id @default(uuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String
  colorHex      String?
  colorName     String?
  priceOverride Decimal? @db.Decimal(12, 0)
  stock         Int      @default(0)
  sortOrder     Int      @default(0)

  images  ProductImage[]
  reviews Review[]

  purchaseOrderItems PurchaseOrderItem[]
  stockMovements     StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]
  cartItems  CartItem[]

  @@index([productId])
  @@index([colorName])
  @@index([stock])
  @@map("product_variants")
}

model ProductImage {
  id          String          @id @default(uuid())
  productId   String
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  url         String
  sortOrder   Int             @default(0)
  isThumbnail Boolean         @default(false)

  @@index([productId])
  @@index([variantId])
  @@map("product_images")
}

model Review {
  id         String        @id @default(uuid())
  productId  String
  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?         @relation(fields: [userId], references: [id])
  authorName String
  rating     Int
  content    String        @db.Text
  images     ReviewImage[]

  variantId        String?
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantLabel     String?
  usedForLabel     String?
  verifiedPurchase Boolean         @default(false)
  helpfulVotes     ReviewHelpful[]
  comments         ReviewComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([variantId])
  @@map("reviews")
}

model ReviewHelpful {
  id        String   @id @default(uuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([reviewId, userId])
  @@index([reviewId])
  @@map("review_helpfuls")
}

model ReviewImage {
  id       String @id @default(uuid())
  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  url      String

  @@map("review_images")
}

model ReviewComment {
  id       String @id @default(uuid())
  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  content  String @db.Text

  parentId String?
  parent   ReviewComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  ReviewComment[] @relation("CommentReplies")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([reviewId])
  @@index([parentId])
  @@map("review_comments")
}

model Address {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  recipientName  String
  recipientPhone String

  provinceCode  Int
  provinceName  String
  wardCode      Int
  wardName      String
  addressDetail String @db.Text

  isDefault Boolean @default(false)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, isDefault])
  @@map("addresses")
}

model Order {
  id          String      @id @default(uuid())
  orderNumber String      @unique
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  status      OrderStatus @default(PENDING)

  payments Payment[]

  subtotal    Decimal @db.Decimal(12, 0)
  shippingFee Decimal @default(0) @db.Decimal(12, 0)
  discount    Decimal @default(0) @db.Decimal(12, 0)
  total       Decimal @db.Decimal(12, 0)

  recipientName   String
  recipientPhone  String
  shippingAddress String  @db.Text
  note            String? @db.Text
  cancelReason    String?

  addressId String?
  address   Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  voucherId   String?
  voucher     Voucher? @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  voucherCode String?

  voucherUsage VoucherUsage?

  items OrderItem[]

  returnRequests ReturnRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([voucherId])
  @@index([addressId])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        String         @id @default(uuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product        @relation(fields: [productId], references: [id])
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  productName  String
  variantName  String
  thumbnailUrl String?
  price        Decimal @db.Decimal(12, 0)
  quantity     Int

  returnRequestItems ReturnRequestItem[]

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

model Payment {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  method           PaymentMethod
  confirmationType ConfirmationType
  status           PaymentStatus    @default(PENDING)

  amount Decimal @db.Decimal(12, 0)

  transferNote  String?
  proofImageUrl String?

  confirmedById String?
  confirmedBy   User?     @relation("PaymentConfirmedBy", fields: [confirmedById], references: [id])
  confirmedAt   DateTime?
  adminNote     String?

  collectedAmount Decimal? @db.Decimal(12, 0)
  courierName     String?

  gatewayTxnId String? @unique
  gatewayRefId String?

  webhookEvents PaymentWebhookEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([method])
  @@map("payments")
}

model PaymentWebhookEvent {
  id        String   @id @default(uuid())
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  provider        PaymentMethod
  eventType       String
  externalEventId String        @unique
  rawPayload      Json
  processedAt     DateTime?
  processingError String?

  createdAt DateTime @default(now())

  @@index([paymentId])
  @@index([provider])
  @@map("payment_webhook_events")
}

model Post {
  id           String  @id @default(uuid())
  title        String
  slug         String  @unique
  excerpt      String?
  thumbnailUrl String?
  content      String  @db.Text

  status      PostStatus @default(DRAFT)
  publishedAt DateTime?
  viewCount   Int        @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@index([deletedAt])
  @@map("posts")
}

model Voucher {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String? @db.Text

  type  VoucherType
  value Decimal     @db.Decimal(12, 0)

  maxDiscount Decimal? @db.Decimal(12, 0)

  minOrderValue Decimal @default(0) @db.Decimal(12, 0)

  scope VoucherScope @default(ALL)

  categories VoucherCategory[]
  products   VoucherProduct[]

  usageLimit        Int?
  usageLimitPerUser Int  @default(1)
  usedCount         Int  @default(0)

  startAt DateTime
  endAt   DateTime

  status   VoucherStatus @default(DRAFT)
  isPublic Boolean       @default(true)

  usages VoucherUsage[]
  orders Order[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([code])
  @@index([status])
  @@index([startAt, endAt])
  @@index([deletedAt])
  @@map("vouchers")
}

model VoucherCategory {
  id         String   @id @default(uuid())
  voucherId  String
  voucher    Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([voucherId, categoryId])
  @@index([categoryId])
  @@map("voucher_categories")
}

model VoucherProduct {
  id        String  @id @default(uuid())
  voucherId String
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([voucherId, productId])
  @@index([productId])
  @@map("voucher_products")
}

model VoucherUsage {
  id        String  @id @default(uuid())
  voucherId String
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id])

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  discountApplied Decimal @db.Decimal(12, 0)

  createdAt DateTime @default(now())

  @@index([voucherId, userId])
  @@index([userId])
  @@map("voucher_usages")
}

model Cart {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("carts")
}

model CartItem {
  id     String @id @default(uuid())
  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  quantity Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
  @@map("cart_items")
}

enum NotificationType {
  ORDER_CREATED
  ORDER_STATUS_CHANGED
  PAYMENT_AWAITING_CONFIRM
  PRODUCT_LOW_STOCK
  REVIEW_CREATED
  COMMENT_CREATED
  RETURN_REQUEST_CREATED
}

enum NotificationAudience {
  ADMIN
  USER
}

model Notification {
  id          String               @id @default(uuid())
  type        NotificationType
  audience    NotificationAudience
  recipientId String?
  title       String
  message     String
  link        String?
  metadata    Json?
  isRead      Boolean              @default(false)
  createdAt   DateTime             @default(now())

  @@index([audience, recipientId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

enum StockMovementType {
  PURCHASE_IN
  SALE_OUT
  RETURN_IN
  ADJUSTMENT
  DAMAGED_OUT
  TRANSFER_IN
  TRANSFER_OUT
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model Supplier {
  id            String  @id @default(uuid())
  name          String
  contactName   String?
  phone         String?
  email         String?
  provinceCode  Int?
  provinceName  String?
  wardCode      Int?
  wardName      String?
  addressDetail String? @db.Text
  note          String? @db.Text

  purchaseOrders PurchaseOrder[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
  @@map("suppliers")
}

model Warehouse {
  id            String  @id @default(uuid())
  name          String
  provinceCode  Int?
  provinceName  String?
  wardCode      Int?
  wardName      String?
  addressDetail String? @db.Text
  isMain        Boolean @default(false)

  stockMovements StockMovement[]
  purchaseOrders PurchaseOrder[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("warehouses")
}

model PurchaseOrder {
  id   String @id @default(uuid())
  code String @unique

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  status PurchaseOrderStatus @default(DRAFT)

  note       String?
  expectedAt DateTime?
  receivedAt DateTime?

  items PurchaseOrderItem[]

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([supplierId])
  @@index([warehouseId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  quantityOrdered  Int
  quantityReceived Int     @default(0)
  unitCost         Decimal @db.Decimal(12, 0)

  @@index([purchaseOrderId])
  @@index([variantId])
  @@map("purchase_order_items")
}

model StockMovement {
  id String @id @default(uuid())

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  type     StockMovementType
  quantity Int

  referenceType String?
  referenceId   String?

  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([variantId])
  @@index([warehouseId])
  @@index([type])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@map("stock_movements")
}

enum ReturnReason {
  WRONG_ITEM
  DEFECTIVE
  DAMAGED_ON_ARRIVAL
  NOT_AS_DESCRIBED
  CHANGE_OF_MIND
  OTHER
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  ITEM_RECEIVED
  REFUNDED
  COMPLETED
  CANCELLED
}

enum RefundMethod {
  BANK_TRANSFER
  ORIGINAL_PAYMENT_METHOD
}

model ReturnRequest {
  id   String @id @default(uuid())
  code String @unique

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])
  userId  String
  user    User   @relation(fields: [userId], references: [id])

  reason     ReturnReason
  reasonNote String?      @db.Text

  status ReturnStatus @default(PENDING)

  items  ReturnRequestItem[]
  images ReturnRequestImage[]

  refundAmount Decimal       @db.Decimal(12, 0)
  refundMethod RefundMethod?

  refundBankName          String?
  refundBankAccountNumber String?
  refundBankAccountHolder String?

  refundedById      String?
  refundedBy        User?    @relation("ReturnRefundedBy", fields: [refundedById], references: [id])
  refundProofImageUrl String?

  adminNote    String? @db.Text
  rejectReason String? @db.Text

  approvedAt     DateTime?
  itemReceivedAt DateTime?
  refundedAt     DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("return_requests")
}

model ReturnRequestItem {
  id              String        @id @default(uuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])

  quantity  Int
  unitPrice Decimal @db.Decimal(12, 0)

  @@index([returnRequestId])
  @@index([orderItemId])
  @@map("return_request_items")
}

model ReturnRequestImage {
  id              String        @id @default(uuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  url             String

  @@index([returnRequestId])
  @@map("return_request_images")
}